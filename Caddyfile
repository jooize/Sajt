# Development reverse proxy for the engine's own workstation: HTTPS on
# localhost in front of `sajt serve`. A site's real Caddyfile is generated
# from its build manifest (`sajt caddyfile`); this file is for developing
# the engine, and carries nothing that identifies a machine or a network.
#
# HSTS belongs at the TLS terminator (Caddy), not the app behind it: the app
# can't tell whether the client used HTTPS. Sent only on the HTTPS sites below.
# Note (dev): this pins HTTPS for `localhost` in your browser for max-age. If you
# ever need plain http://localhost for another project, clear it via the browser
# (Chrome: chrome://net-internals/#hsts -> delete "localhost"). `preload` is
# deliberately omitted — it is for the public domain, never localhost.
(hsts) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

https://localhost {
	import hsts
	reverse_proxy localhost:1234
}

http://localhost {
	redir https://localhost{uri} permanent
}

# Blocks that name a machine or a network (a LAN address, a container's IP)
# live in the gitignored Caddyfile.local next to this file. The glob keeps a
# missing file from being an error, so a fresh clone works as-is.
import Caddyfile.local*
