/target
# `nix build` drops a symlink into the Nix store here; it is a pointer to a
# build, never a source file.
/result
/result-*
/content
/.agents-cargo
.DS_Store
/server.log

# Workstation-specific Caddy blocks (LAN and container addresses): machine
# data, imported by the committed Caddyfile when present.
/Caddyfile.local*
/.cache

# Build output: blobs and manifest of the operator's real site. Personal
# site data must never enter this repository.
/build

# Agent/session state (personal notes, scratch, trash). Covered by the
# user's global ignore too; listed here so a clone without that global
# config still cannot commit them.
/.claude-memory
/.agents-work
/.tmp
/.trash
SECRETS.md
